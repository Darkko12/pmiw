// ============================================
// EL DESTINO DE PANDORA - NOVELA VISUAL (versión sencilla y completa)
// ============================================

let pantalla = 0;
let imagenes = [];
let musicaFondo, musicaBueno, musicaMalo, clickSound;
let isMuted = false;
let botonSonido;

// ============================================
// CARGA DE IMÁGENES Y SONIDOS
// ============================================
function preload() {
  let urls = [
    "https://i.imgur.com/MzHzEbp.png", // 0 - inicio
    "https://i.imgur.com/a0qkcwf.png", // 1
    "https://i.imgur.com/1t2pTNy.png", // 2
    "https://i.imgur.com/14Ess8N.png", // 3
    "https://i.imgur.com/14Ess8N.png", // 4 - decisión
    "https://i.imgur.com/14Ess8N.png", // 5 - final bueno
    "https://i.imgur.com/14Ess8N.png", // 6 - final malo
    "https://i.imgur.com/14Ess8N.png"  // 7 - créditos
  ];
  for (let i = 0; i < urls.length; i++) {
    imagenes[i] = loadImage(urls[i]);
  }

  // 🎵 Si querés, después poné tus propios sonidos:
  // musicaFondo = loadSound("https://...");
  // musicaBueno = loadSound("https://...");
  // musicaMalo = loadSound("https://...");
  // clickSound = loadSound("https://...");
}

// ============================================
// CONFIGURACIÓN
// ============================================
function setup() {
  createCanvas(640, 480);
  textAlign(CENTER, CENTER);
  textSize(18);

  // Música base
  if (musicaFondo) {
    musicaFondo.loop();
    musicaFondo.setVolume(0.3);
  }

  // Botón de sonido
  botonSonido = createButton("🔊");
  botonSonido.position(width - 60, 20);
  botonSonido.mousePressed(toggleSound);
  botonSonido.style("background", "#333");
  botonSonido.style("color", "white");
  botonSonido.style("border", "none");
  botonSonido.style("border-radius", "5px");
  botonSonido.style("padding", "5px");
  botonSonido.style("cursor", "pointer");
}

// ============================================
// DIBUJO PRINCIPAL
// ============================================
function draw() {
  background(0);

  if (imagenes[pantalla]) {
    image(imagenes[pantalla], 0, 0, width, height);
  }

  // Caja de texto
  fill(0, 150);
  noStroke();
  rect(0, height - 120, width, 120);

  fill(255);
  textSize(16);
  textWrap(WORD);
  text(getTexto(), width / 2, height - 60, width - 40);

  // Dibujar botones según pantalla
  dibujarBotones();
}

// ============================================
// TEXTOS
// ============================================
function getTexto() {
  if (pantalla == 0)
    return "EL DESTINO DE PANDORA\n\nHaz clic en 'Comenzar' para iniciar.";
  if (pantalla == 1)
    return "Los dioses forjaron a Pandora como un regalo para la humanidad.";
  if (pantalla == 2)
    return "Zeus le entrega una caja sellada, advirtiendo: 'Jamás la abras'.";
  if (pantalla == 3)
    return "Pandora siente una fuerte curiosidad por abrir la caja...";
  if (pantalla == 4)
    return "¿Qué debería hacer Pandora?";
  if (pantalla == 5)
    return "FINAL BUENO 🌟\n\nPandora libera la esperanza.\nEl mundo renace.";
  if (pantalla == 6)
    return "FINAL MALO 💀\n\nLos males consumen la tierra.\nTodo se pierde.";
  if (pantalla == 7)
    return "CRÉDITOS\n\nEl Destino de Pandora\nCreado por [Tu Nombre]\nMateria: Programación I - 2025";
  return "";
}

// ============================================
// BOTONES BÁSICOS
// ============================================
function dibujarBotones() {
  textSize(14);
  fill(255);
  noStroke();

  if (pantalla == 0) {
    dibujarBoton(width / 2 - 60, height - 50, 120, 35, "Comenzar");
  } else if (pantalla >= 1 && pantalla <= 3) {
    dibujarBoton(width / 2 - 60, height - 50, 120, 35, "Continuar");
  } else if (pantalla == 4) {
    dibujarBoton(width / 2 - 130, height - 50, 110, 35, "Abrir caja");
    dibujarBoton(width / 2 + 20, height - 50, 110, 35, "Ignorar");
  } else if (pantalla == 5 || pantalla == 6) {
    dibujarBoton(width / 2 - 60, height - 50, 120, 35, "Créditos");
  } else if (pantalla == 7) {
    dibujarBoton(width / 2 - 60, height - 50, 120, 35, "Reiniciar");
  }
}

// ============================================
// FUNCIÓN BOTÓN SIMPLE
// ============================================
function dibujarBoton(x, y, w, h, texto) {
  // Hover
  if (mouseX > x && mouseX < x + w && mouseY > y && mouseY < y + h) {
    fill(255, 100);
  } else {
    fill(255, 50);
  }

  rect(x, y, w, h, 5);
  fill(255);
  noStroke();
  text(texto, x + w / 2, y + h / 2);
}

// ============================================
// CLICS
// ============================================
function mousePressed() {
  // Ignorar clics sobre el botón de sonido
  if (mouseX > width - 70 && mouseY < 50) return;

  // Reproducir sonido de clic
  if (clickSound && !isMuted) clickSound.play();

  // Botones
  if (pantalla == 0 && dentro(width / 2 - 60, height - 50, 120, 35)) pantalla = 1;
  else if (pantalla >= 1 && pantalla <= 3 && dentro(width / 2 - 60, height - 50, 120, 35)) pantalla++;
  else if (pantalla == 4 && dentro(width / 2 - 130, height - 50, 110, 35)) {
    pantalla = 5;
    cambiarMusicaFinal("bueno");
  } else if (pantalla == 4 && dentro(width / 2 + 20, height - 50, 110, 35)) {
    pantalla = 6;
    cambiarMusicaFinal("malo");
  } else if ((pantalla == 5 || pantalla == 6) && dentro(width / 2 - 60, height - 50, 120, 35)) pantalla = 7;
  else if (pantalla == 7 && dentro(width / 2 - 60, height - 50, 120, 35)) {
    pantalla = 0;
    if (musicaBueno) musicaBueno.stop();
    if (musicaMalo) musicaMalo.stop();
    if (musicaFondo && !isMuted) musicaFondo.loop();
  }
}

// ============================================
// FUNCIÓN DE AYUDA PARA DETECTAR CLICS
// ============================================
function dentro(x, y, w, h) {
  return mouseX > x && mouseX < x + w && mouseY > y && mouseY < y + h;
}

// ============================================
// MÚSICA FINAL
// ============================================
function cambiarMusicaFinal(tipo) {
  if (musicaFondo) musicaFondo.stop();
  if (tipo == "bueno" && musicaBueno && !isMuted) musicaBueno.play();
  if (tipo == "malo" && musicaMalo && !isMuted) musicaMalo.play();
}

// ============================================
// SONIDO MUTE
// ============================================
function toggleSound() {
  isMuted = !isMuted;
  botonSonido.html(isMuted ? "🔇" : "🔊");

  let volumen = isMuted ? 0 : 0.3;

  if (musicaFondo) musicaFondo.setVolume(volumen);
  if (musicaBueno) musicaBueno.setVolume(volumen);
  if (musicaMalo) musicaMalo.setVolume(volumen);
  if (clickSound) clickSound.setVolume(volumen);
}
